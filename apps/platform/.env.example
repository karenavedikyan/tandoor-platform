# Скопируйте в `.env` в этой же папке (`apps/platform/.env`) для локального запуска.
# Не добавляйте реальные секреты, токены Bitrix24, ключи 1С или Google в git.

# Режим Node (development | production)
NODE_ENV=development

# Порт HTTP-сервера приложения
PORT=5000

# --- Зарезервировано под интеграции (значения только в закрытом окружении) ---
# BITRIX24_WEBHOOK_URL=
# BITRIX_REST_CLIENT_ID=
# BITRIX_REST_CLIENT_SECRET=
# ONEC_HTTP_USER=
# ONEC_HTTP_PASSWORD=
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# Загрузка фото клиентской базы (актуализация): Vercel Blob. Без токена UI покажет «не настроено».
# BLOB_READ_WRITE_TOKEN=

# Яндекс.Карты (клиентская карта /#/client-map; только отображение заранее подготовленных координат)
# VITE_YANDEX_MAPS_API_KEY=

# Web Vitals (Промт 382): сбор метрик в БД + дашборд /admin/performance
# WEB_VITALS_ENABLED=true
# VITE_WEB_VITALS_ENABLED=true

# ====== Migration-only (Neon → Yandex), временно ======
# Set in Vercel env. Required for /api/admin/db-migrate/* endpoints
MIGRATION_DUMP_SECRET=
# CA-cert для verify-full SSL подключения к Yandex Managed PostgreSQL
# Multi-line PEM, задаётся через Vercel env как одно значение
PG_SSL_ROOT_CERT=
# Yandex PostgreSQL URLs (используется на этапе restore и dual-write)
YANDEX_DATABASE_URL=
YANDEX_DATABASE_URL_UNPOOLED=
