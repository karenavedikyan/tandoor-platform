// Prisma schema: каталог 1С (Промт 116). Остальные таблицы — Drizzle (shared/auth-schema.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogCategory {
  id        String   @id @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  raw       Json?
  syncedAt  DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  parent    CatalogCategory?  @relation("CatChild", fields: [parentId], references: [id], onDelete: SetNull)
  children  CatalogCategory[] @relation("CatChild")

  @@map("catalog_categories")
}

model CatalogGroup {
  id       String   @id @db.Uuid
  parentId String?  @map("parent_id") @db.Uuid
  name     String?
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@map("catalog_groups")
}

model CatalogProduct {
  id          String   @id @db.Uuid
  groupId     String?  @map("group_id") @db.Uuid
  name        String
  active      Boolean  @default(true)
  brand       String?
  displayName String?  @map("display_name")
  isOnSite    Boolean  @default(false) @map("is_on_site")
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  properties  CatalogProductProperty[]
  categories  CatalogProductCategory[]
  images      CatalogProductImage[]
  stocks      CatalogStock[]
  prices      CatalogPrice[]
  bitrixOrderItems BitrixOrderItemSnapshot[]

  @@map("catalog_products")
}

model CatalogProductProperty {
  productId    String  @map("product_id") @db.Uuid
  propertyCode String  @map("property_code") @db.Uuid
  name         String
  value        String?
  product      CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, propertyCode])
  @@map("catalog_product_properties")
}

model CatalogProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  product    CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("catalog_product_categories")
}

model CatalogProductImage {
  id              BigInt    @id @default(autoincrement())
  productId       String    @map("product_id") @db.Uuid
  path            String
  sortOrder       Int       @default(0) @map("sort_order")
  blobUrl         String?   @map("blob_url")
  blobSize        BigInt?   @map("blob_size")
  blobUploadedAt  DateTime? @map("blob_uploaded_at") @db.Timestamptz(6)
  sourceSize      BigInt?   @map("source_size")
  sourceMtime     DateTime? @map("source_mtime") @db.Timestamptz(6)
  product         CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, path], map: "catalog_product_images_product_path_uq")
  @@map("catalog_product_images")
}

model CatalogWarehouse {
  id       String   @id @db.Uuid
  name     String?
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@map("catalog_warehouses")
}

model CatalogStock {
  productId   String  @map("product_id") @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  qty         Decimal @default(0) @db.Decimal(18, 3)
  expectedQty Decimal @default(0) @map("expected_qty") @db.Decimal(18, 3)
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  product     CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
  @@map("catalog_stocks")
}

model CatalogPriceType {
  id       String @id @db.Uuid
  name     String
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  prices   CatalogPrice[]

  @@map("catalog_price_types")
}

model CatalogPrice {
  productId   String   @map("product_id") @db.Uuid
  priceTypeId String   @map("price_type_id") @db.Uuid
  value       Decimal? @db.Decimal(18, 2)
  currency    String   @default("RUB")
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  product     CatalogProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceType   CatalogPriceType @relation(fields: [priceTypeId], references: [id], onDelete: Cascade)

  @@id([productId, priceTypeId])
  @@map("catalog_prices")
}

model CatalogSyncLog {
  id           BigInt    @id @default(autoincrement())
  sourceFile   String    @map("source_file")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  status       String    @default("running")
  rowsTotal    Int       @default(0) @map("rows_total")
  rowsUpserted Int       @default(0) @map("rows_upserted")
  rowsSkipped  Int       @default(0) @map("rows_skipped")
  error        String?
  details      Json?

  @@map("catalog_sync_log")
}

model BitrixOrdersSnapshot {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bitrixOrderId     String    @unique @map("bitrix_order_id")
  orderNumber       String    @map("order_number")
  siteId            String?   @map("site_id")
  clientUuid        String?   @map("client_uuid")
  clientNumber1c    String?   @map("client_number_1c")
  storeUuid         String?   @map("store_uuid") @db.Uuid
  legalUuid         String?   @map("legal_uuid") @db.Uuid
  managerUuid       String?   @map("manager_uuid") @db.Uuid
  status            String
  deliveryType      String?   @map("delivery_type")
  deliveryAddress   String?   @map("delivery_address")
  paymentMethod     String?   @map("payment_method")
  paymentPercent    Decimal?  @map("payment_percent") @db.Decimal(6, 2)
  totalWithDiscount Decimal?  @map("total_with_discount") @db.Decimal(14, 2)
  totalDiscount     Decimal?  @map("total_discount") @db.Decimal(14, 2)
  createdAtBitrix   DateTime? @map("created_at_bitrix") @db.Timestamptz(6)
  rawPayload        Json      @map("raw_payload")
  sourceFile        String?   @map("source_file")
  importedAt        DateTime  @default(now()) @map("imported_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items             BitrixOrderItemSnapshot[]

  @@index([clientNumber1c], map: "bitrix_orders_snapshot_client_number_1c_idx")
  @@index([storeUuid], map: "bitrix_orders_snapshot_store_uuid_idx")
  @@index([legalUuid], map: "bitrix_orders_snapshot_legal_uuid_idx")
  @@index([managerUuid], map: "bitrix_orders_snapshot_manager_uuid_idx")
  @@index([status], map: "bitrix_orders_snapshot_status_idx")
  @@index([createdAtBitrix(sort: Desc)], map: "bitrix_orders_snapshot_created_at_bitrix_idx")
  @@map("bitrix_orders_snapshot")
}

model BitrixOrderItemSnapshot {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String             @map("order_id") @db.Uuid
  lineNo                Int                @map("line_no")
  productXmlId          String             @map("product_xml_id")
  productId             String?            @map("product_id") @db.Uuid
  productName1c         String?            @map("product_name_1c")
  quantity              Decimal            @db.Decimal(14, 3)
  discountPerItem       Decimal?           @map("discount_per_item") @db.Decimal(14, 2)
  priceNoDiscount       Decimal?           @map("price_no_discount") @db.Decimal(14, 2)
  discountId            String?            @map("discount_id")
  productId1cInternal   String?            @map("product_id_1c_internal")
  priceTypeUuid         String?            @map("price_type_uuid")
  supplyVariant         String?            @map("supply_variant")
  supplyDate            DateTime?          @map("supply_date") @db.Timestamptz(6)
  order                 BitrixOrdersSnapshot @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               CatalogProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "bitrix_order_items_snapshot_order_id_idx")
  @@index([productId], map: "bitrix_order_items_snapshot_product_id_idx")
  @@index([productXmlId], map: "bitrix_order_items_snapshot_product_xml_id_idx")
  @@map("bitrix_order_items_snapshot")
}

model BitrixOrdersSyncLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)
  source            String
  sourceFile        String?   @map("source_file")
  ordersSeen        Int       @default(0) @map("orders_seen")
  ordersUpserted    Int       @default(0) @map("orders_upserted")
  ordersMatchedStore Int      @default(0) @map("orders_matched_store")
  ordersUnmatched   Int       @default(0) @map("orders_unmatched")
  status            String    @default("ok")
  message           String?
  durationMs        Int?      @map("duration_ms")

  @@index([startedAt(sort: Desc)], map: "bitrix_orders_sync_log_started_at_idx")
  @@map("bitrix_orders_sync_log")
}
