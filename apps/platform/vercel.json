{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "images": {
    "sizes": [64, 80, 96, 128, 160, 200, 256, 320, 640, 750, 828, 1080, 1200, 1600, 1920],
    "minimumCacheTTL": 86400,
    "formats": ["image/webp"],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "ospv42n5b4su63ca.public.blob.vercel-storage.com"
      },
      {
        "protocol": "https",
        "hostname": "*.public.blob.vercel-storage.com"
      }
    ]
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/sales-plan-fact/state",
      "destination": "/api/actualization/state?_route=sales-plan-fact"
    },
    {
      "source": "/api/cron/purge-trash",
      "destination": "/api/actualization/state?_route=purge-trash"
    },
    {
      "source": "/p/brief/:id",
      "destination": "/api/p/brief/:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-yandex",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/purge-trash",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-catalog-1c",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/sync-catalog-1c-photos",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/refresh-activity-summary",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup-web-vitals",
      "schedule": "0 2 * * 0"
    }
  ]
}
